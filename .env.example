# Copie este arquivo para .env e ajuste os valores (o .env não vai para o Git)

# URL de conexão do PostgreSQL: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devshowcase

# Porta da API (no Render ela é definida automaticamente)
PORT=3000

# true quando o banco exige SSL (ex.: URL externa do Render ou Supabase)
DATABASE_SSL=false
